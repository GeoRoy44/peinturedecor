---
import Base from '../../layouts/Base.astro';
import HeroAnime from '../../components/HeroAnime.astro';
import '../../styles/article.css';
import { getCollection, render } from 'astro:content';
import { categories, type Categorie } from '../../data/categories';
import { getArticles, urlArticle } from '../../lib/articles';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { categorie: c.slug }, props: { cat: c } }));
}

const { cat } = Astro.props as { cat: Categorie };
const autres = categories.filter((c) => c.slug !== cat.slug);
const articles = await getArticles(cat.slug);
const mere = (await getCollection('meres')).find((m) => m.id === cat.slug);
const Contenu = mere ? (await render(mere)).Content : null;
const titreSeo = mere ? mere.data.seoTitle : `${cat.titre} – PeintureDécor.fr`;
const description = mere ? mere.data.description : cat.description;
const h1 = mere ? mere.data.h1 : cat.h1;
---
<Base title={titreSeo} description={description}>
  <HeroAnime kicker={cat.titre} titre={h1} intro={cat.intro} variante={cat.variante} ctaLabel="Voir les guides" ctaHref="#guides" />
  {Contenu && (
    <section class="section">
      <div class="container article">
        <nav class="fil" aria-label="Fil d'Ariane"><a href="/">Accueil</a> / {cat.titre}</nav>
        <div class="prose">
          <Contenu />
        </div>
      </div>
    </section>
  )}
  <section id="guides" class="section">
    <div class="container">
      {!Contenu && <nav class="fil" aria-label="Fil d'Ariane"><a href="/">Accueil</a> / {cat.titre}</nav>}
      <h2>Guides {cat.titre.toLowerCase()}</h2>
      {articles.length > 0 ? (
        <div class="cartes">
          {articles.map((a) => (
            <a href={urlArticle(a)} class={`carte carte--${cat.variante}`}>
              <h3>{a.data.title}</h3>
              <p>{a.data.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <p>Les premiers guides arrivent bientôt.</p>
      )}
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>Autres univers</h2>
      <div class="cartes">
        {autres.map((c) => (
          <a href={`/${c.slug}/`} class={`carte carte--${c.variante}`}>
            <h3>{c.titre}</h3>
            <p>{c.intro}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
