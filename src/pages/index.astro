---
import Base from '../layouts/Base.astro';
import HeroAnime from '../components/HeroAnime.astro';
import { categories } from '../data/categories';

const verification = '<!-- 945a170f8e111bebc668b7655b27c7be -->';
---
<Base title="PeintureDécor.fr – Peindre, décorer, trouver un peintre" description="Méthodes pour peindre un mur, peinture décorative, comparatifs, façade et annuaire de peintres : tous nos guides.">
  <Fragment set:html={verification} />
  <HeroAnime
    kicker="Peinture & décoration intérieure"
    titre="Donnez de la matière à vos murs"
    intro="Peindre comme un pro, oser le tadelakt ou la chaux, choisir sa peinture ou trouver le bon artisan."
    variante="terracotta"
  />
  <section id="guides" class="section">
    <div class="container">
      <h2>Nos univers</h2>
      <div class="cartes">
        {categories.map((c) => (
          <a href={`/${c.slug}/`} class={`carte carte--${c.variante}`}>
            <h3>{c.titre}</h3>
            <p>{c.intro}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="bandeau">
        <h2>Besoin d'un devis peinture ?</h2>
        <a href="/peintre-en-batiment/" class="btn">Trouver un peintre <span class="btn__fleche" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>
